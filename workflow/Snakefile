"""Pan-TAG v0.1.

Run inside the Pixi environment:
pixi run snakemake --snakefile workflow/Snakefile \
  --configfile config/config.yaml --cores 8
"""

import csv
import hashlib
import os
import re
from pathlib import Path


LAUNCH_DIR = Path.cwd().resolve()
PROJECT_ROOT = Path(workflow.basedir).resolve().parent


def run_path(value):
    """Resolve user paths against the directory where Snakemake was launched."""
    path = Path(str(value)).expanduser()
    return str(path.resolve() if path.is_absolute() else (LAUNCH_DIR / path).resolve())


def executable(value):
    """Keep PATH command names, but anchor explicit executable paths."""
    path = Path(str(value)).expanduser()
    return str(value) if path.parent == Path(".") else run_path(path)


SAMPLES_FILE = run_path(config["samples"])
RESULTS = run_path(config["results_dir"])
LOGS = run_path(config["logs_dir"])
WORK = run_path(config["work_dir"])
SOFTWARE_CONFIG = config["software"]
DIAMOND_BIN = executable(SOFTWARE_CONFIG["diamond"])
GFFREAD_BIN = executable(SOFTWARE_CONFIG["gffread"])
MCScanX_BUILD_SCRIPT = str(PROJECT_ROOT / "src/pantag/mcscanx/build.sh")
MCScanX_SOURCE = str(PROJECT_ROOT / "src/pantag/mcscanx/MCScanX-source.tar.gz")
LIFTOFF_DB_SCRIPT = str(PROJECT_ROOT / "src/pantag/liftoff_db.py")

# Keep Snakemake locks and persistence metadata inside this dataset's work_dir.
Path(WORK).mkdir(parents=True, exist_ok=True)
workdir: WORK


def load_samples(path):
    with open(path, newline="", encoding="utf-8") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        if reader.fieldnames != ["sample_id", "fasta", "gff"]:
            raise ValueError(
                f"{path} must contain exactly, in order: sample_id, fasta, gff"
            )
        rows = list(reader)
    if not rows:
        raise ValueError(f"{path} must contain a reference sample row")
    for row in rows:
        row["fasta"] = run_path(row["fasta"])
        if (row.get("gff") or "").strip():
            row["gff"] = run_path(row["gff"])
    samples = {row["sample_id"]: row for row in rows}
    if len(samples) != len(rows):
        raise ValueError("sample_id values must be unique")
    return samples


REFERENCE = config["reference"]["sample_id"]
TARGETS = load_samples(SAMPLES_FILE)
FIRST_SAMPLE = next(iter(TARGETS))
if FIRST_SAMPLE != REFERENCE:
    raise ValueError(
        "The first samples.tsv row must be the reference sample recorded in config.yaml"
    )
TARGETS.pop(REFERENCE)

ALL_SAMPLES = [REFERENCE] + sorted(TARGETS)
REFERENCE_FASTA = run_path(config["reference"]["fasta"])
REFERENCE_GFF = run_path(config["reference"]["gff"])
SAMPLE_ORDER = [REFERENCE] + list(TARGETS)
SAMPLE_FASTAS = {
    REFERENCE: REFERENCE_FASTA,
    **{sample: row["fasta"] for sample, row in TARGETS.items()},
}
FASTA_INDEXES = [
    f"{WORK}/{sample}/genome.fa.fai"
    for sample in SAMPLE_ORDER
]
ANNOTATION_MODE = str(config["annotation"]["mode"]).lower()
if ANNOTATION_MODE not in {"liftoff", "provided"}:
    raise ValueError("annotation.mode must be 'liftoff' or 'provided'")
for sample, row in TARGETS.items():
    provided_gff = (row.get("gff") or "").strip()
    if ANNOTATION_MODE == "liftoff" and provided_gff:
        raise ValueError(f"{sample}: gff must be empty in liftoff mode")
    if ANNOTATION_MODE == "provided" and not provided_gff:
        raise ValueError(f"{sample}: gff is required in provided mode")
SAMPLE_GFFS = {
    REFERENCE: REFERENCE_GFF,
    **{
        sample: (
            row["gff"]
            if ANNOTATION_MODE == "provided"
            else f"{RESULTS}/liftoff/{sample}.liftoff.gff3"
        )
        for sample, row in TARGETS.items()
    },
}
LIFTOFF_SAMPLES = sorted(TARGETS) if ANNOTATION_MODE == "liftoff" else []
LIFTOFF_PATTERN = (
    "|".join(re.escape(sample) for sample in LIFTOFF_SAMPLES) or r"(?!)"
)
LIFTOFF_CONFIG = config["liftoff"]
LIFTOFF_ENVIRONMENT = str(LIFTOFF_CONFIG["pixi_environment"])
_liftoff_executable = Path(str(LIFTOFF_CONFIG["executable"])).expanduser()
LIFTOFF_BIN = (
    str(_liftoff_executable.resolve())
    if _liftoff_executable.parent != Path(".")
    else str(PROJECT_ROOT / ".pixi/envs" / LIFTOFF_ENVIRONMENT / "bin" / _liftoff_executable)
)
LIFTOFF_PYTHON = str(
    PROJECT_ROOT / ".pixi/envs" / LIFTOFF_ENVIRONMENT / "bin/python"
)
LIFTOFF_REFERENCE_DB = f"{WORK}/liftoff/reference_annotation.db"
LIFTOFF_FEATURE_TYPES = str(PROJECT_ROOT / "config/liftoff_features.txt")
MCScanX_BIN = f"{WORK}/software/MCScanX_pantag"
MCScanX_BUILD_INFO = f"{WORK}/software/MCScanX_pantag.build_info.txt"
DOWNSTREAM = f"{RESULTS}/downstream"
DOWNSTREAM_WORK = f"{WORK}/downstream"
STRUCTURE_GENE_INDEX = f"{DOWNSTREAM_WORK}/structure_genes.sqlite"
DOWNSTREAM_CONFIG = config["downstream"]
EXTRACT_CONFIG = DOWNSTREAM_CONFIG["extract"]
REFINE_CONFIG = config["refine"]
REFINE_FLANK_THRESHOLD = float(REFINE_CONFIG["flank_overlap_threshold"])
if not 0 <= REFINE_FLANK_THRESHOLD <= 1:
    raise ValueError("refine.flank_overlap_threshold must be between 0 and 1")
CLUSTER_CONFIG = DOWNSTREAM_CONFIG["cluster"]
RUNTIME_DOWNSTREAM_TARGETS_RAW = str(config.get("_pantag_downstream_targets", "__ALL__"))
RUNTIME_DOWNSTREAM_ALL = RUNTIME_DOWNSTREAM_TARGETS_RAW == "__ALL__"
RUNTIME_DOWNSTREAM_TARGETS = (
    [] if RUNTIME_DOWNSTREAM_ALL
    else list(dict.fromkeys(
        tag.strip() for tag in RUNTIME_DOWNSTREAM_TARGETS_RAW.split(",") if tag.strip()
    ))
)
if not RUNTIME_DOWNSTREAM_ALL and not RUNTIME_DOWNSTREAM_TARGETS:
    raise ValueError("No Pan-cluster IDs were supplied at runtime")
if any(not re.fullmatch(r"[A-Za-z0-9_.-]+", tag) for tag in RUNTIME_DOWNSTREAM_TARGETS):
    raise ValueError("Runtime Pan-cluster IDs may contain only letters, digits, '.', '_' and '-'")
DOWNSTREAM_SELECTION_ID = hashlib.sha256(
    RUNTIME_DOWNSTREAM_TARGETS_RAW.encode("utf-8")
).hexdigest()[:12]
CONFIG_PATH = run_path(workflow.configfiles[0])
PCOA_ENABLED = bool(CLUSTER_CONFIG["pcoa"])
CLUSTER_PCOA_PATTERN = (
    f"{DOWNSTREAM}/{{global_tag}}/clusters/{{global_tag}}_pcoa.pdf"
    if PCOA_ENABLED
    else f"{DOWNSTREAM_WORK}/clusters/{{global_tag}}/pcoa.disabled"
)
PSEUDOGENE_CONFIG = config["pseudogene"]
PSEUDOGENE_ENABLED = bool(PSEUDOGENE_CONFIG["enabled"])
FLANK_CONFIG = config["flanks"]
OUTPUT_CONFIG = config["outputs"]
DEBUG_OUTPUTS = bool(OUTPUT_CONFIG["debug"])
LOCAL_TO_GLOBAL = (
    f"{RESULTS}/global/local_to_global.tsv"
    if DEBUG_OUTPUTS else f"{WORK}/global/local_to_global.tsv"
)
CORE_TARGETS = [
    f"{RESULTS}/global/pangenome_TAGs.tsv",
    f"{RESULTS}/global/refined_TAG_count_matrix.tsv",
]
if DEBUG_OUTPUTS:
    CORE_TARGETS.append(LOCAL_TO_GLOBAL)


def sample_fasta(wildcards):
    return SAMPLE_FASTAS[wildcards.sample]


def sample_gff(wildcards):
    return SAMPLE_GFFS[wildcards.sample]


rule all:
    input:
        CORE_TARGETS,


rule validate_inputs:
    input:
        config=lambda wc: workflow.configfiles[0],
        samples=SAMPLES_FILE,
        reference_fasta=REFERENCE_FASTA,
        reference_gff=REFERENCE_GFF,
        target_fastas=[TARGETS[sample]["fasta"] for sample in sorted(TARGETS)],
        provided_target_gffs=[
            (TARGETS[sample].get("gff") or "").strip()
            for sample in sorted(TARGETS)
            if ANNOTATION_MODE == "provided"
        ],
    output:
        f"{RESULTS}/input_validation.json",
    log:
        f"{LOGS}/validate_inputs.log",
    shell:
        """
        mkdir -p $(dirname {output}) $(dirname {log})
        python -m pantag.prepare validate-inputs \
          --config {input.config} \
          --samples {input.samples} \
          --output {output} \
          > {log} 2>&1
        """


rule build_mcscanx_pantag:
    input:
        validated=f"{RESULTS}/input_validation.json",
        script=MCScanX_BUILD_SCRIPT,
        source=MCScanX_SOURCE,
    output:
        binary=MCScanX_BIN,
        build_info=MCScanX_BUILD_INFO,
    log:
        f"{LOGS}/build_mcscanx.log",
    shell:
        """
        mkdir -p $(dirname {log})
        bash {input.script:q} {output.binary:q} {output.build_info:q} > {log:q} 2>&1
        test -x {output.binary}
        test -s {output.build_info}
        """


rule build_liftoff_db:
    input:
        validated=f"{RESULTS}/input_validation.json",
        reference_gff=REFERENCE_GFF,
        script=LIFTOFF_DB_SCRIPT,
    output:
        db=LIFTOFF_REFERENCE_DB,
    params:
        python=LIFTOFF_PYTHON,
    log:
        f"{LOGS}/liftoff/build_reference_db.log",
    shell:
        """
        mkdir -p $(dirname {output.db}) $(dirname {log})
        test -x {params.python:q} || {{
          echo "Liftoff environment is not installed: {params.python}" >&2
          exit 1
        }}
        {params.python:q} {input.script:q} \
          --gff {input.reference_gff:q} \
          --output {output.db:q} \
          > {log:q} 2>&1
        """


rule liftoff:
    input:
        validated=f"{RESULTS}/input_validation.json",
        target_fasta=lambda wc: TARGETS[wc.sample]["fasta"],
        reference_fasta=REFERENCE_FASTA,
        reference_db=LIFTOFF_REFERENCE_DB,
        feature_types=LIFTOFF_FEATURE_TYPES,
    output:
        gff=f"{RESULTS}/liftoff/{{sample}}.liftoff.gff3",
    params:
        intermediate=f"{WORK}/liftoff/{{sample}}/intermediate_files_{{sample}}",
        executable=LIFTOFF_BIN,
    threads:
        LIFTOFF_CONFIG["threads"]
    log:
        f"{LOGS}/liftoff/{{sample}}.log",
    wildcard_constraints:
        sample=LIFTOFF_PATTERN,
    shell:
        """
        mkdir -p $(dirname {output.gff}) {params.intermediate} $(dirname {log})
        test -x {params.executable:q} || {{
          echo "Liftoff environment is not installed: {params.executable}" >&2
          echo "Run 'pixi install --environment {LIFTOFF_ENVIRONMENT}' in {PROJECT_ROOT} on a login node." >&2
          exit 1
        }}
        {params.executable:q} {input.target_fasta:q} {input.reference_fasta:q} \
          -db {input.reference_db:q} \
          -o {output.gff:q} \
          -dir {params.intermediate:q} \
          -exclude_partial \
          -p {threads} \
          -f {input.feature_types:q} \
          -copies \
          -sc 0.95 \
          > {log} 2>&1
        """


rule gffread_proteins:
    input:
        fasta=sample_fasta,
        gff=sample_gff,
    output:
        proteins=f"{WORK}/{{sample}}/{{sample}}_raw_protein.faa",
        fasta_index=f"{WORK}/{{sample}}/genome.fa.fai",
    log:
        f"{LOGS}/gffread/{{sample}}.log",
    params:
        executable=GFFREAD_BIN,
        fasta=lambda wc: f"{WORK}/{wc.sample}/genome.fa",
    shell:
        """
        mkdir -p $(dirname {output.proteins}) $(dirname {log})
        ln -sfn {input.fasta:q} {params.fasta:q}
        python -m pantag.fasta --fasta {input.fasta:q} --index {output.fasta_index:q}
        {params.executable} {input.gff:q} -g {params.fasta:q} -y {output.proteins:q} > {log:q} 2>&1
        """


rule prepare_tag_inputs:
    input:
        config=lambda wc: workflow.configfiles[0],
        gff=sample_gff,
        raw_proteins=f"{WORK}/{{sample}}/{{sample}}_raw_protein.faa",
    output:
        mcscanx_gff=f"{WORK}/{{sample}}/{{sample}}.gff",
        gene_map=f"{WORK}/{{sample}}/{{sample}}.map",
        proteins=f"{WORK}/{{sample}}/{{sample}}_renamed_protein.faa",
        qc=f"{WORK}/{{sample}}/{{sample}}_prepare_qc.tsv",
    log:
        f"{LOGS}/prepare/{{sample}}.log",
    shell:
        """
        mkdir -p $(dirname {log})
        python -m pantag.prepare tag-inputs \
          --sample-id {wildcards.sample} \
          --config {input.config} \
          --annotation-gff {input.gff} \
          --raw-proteins {input.raw_proteins} \
          --output-mcscanx-gff {output.mcscanx_gff} \
          --output-gene-map {output.gene_map} \
          --output-proteins {output.proteins} \
          --output-qc {output.qc} \
          > {log} 2>&1
        """


rule single_sample_tag:
    input:
        config=lambda wc: workflow.configfiles[0],
        mcscanx_bin=MCScanX_BIN,
        mcscanx_gff=f"{WORK}/{{sample}}/{{sample}}.gff",
        gene_map=f"{WORK}/{{sample}}/{{sample}}.map",
        proteins=f"{WORK}/{{sample}}/{{sample}}_renamed_protein.faa",
        gff=sample_gff,
        fasta=sample_fasta,
    output:
        blast_raw=temp(f"{WORK}/{{sample}}/{{sample}}.blast.raw"),
        blast=f"{WORK}/{{sample}}/{{sample}}.blast",
        tandem=f"{WORK}/{{sample}}/{{sample}}.tandem",
        cluster=f"{WORK}/{{sample}}/{{sample}}_gene.cluster",
        final=(
            f"{WORK}/{{sample}}/{{sample}}_coding_TAGs.tsv"
            if PSEUDOGENE_ENABLED
            else f"{RESULTS}/local_tags/{{sample}}_TAGs.tsv"
        ),
    params:
        workdir=lambda wc: f"{WORK}/{wc.sample}",
        identity=config["tag"]["blastp_identity"],
        query_coverage=config["tag"]["blastp_query_coverage"],
        subject_coverage=config["tag"]["blastp_subject_coverage"],
        max_target_seqs=config["tag"]["diamond_max_target_seqs"],
        diamond=DIAMOND_BIN,
        flank_genes=FLANK_CONFIG["gene_count"],
    threads:
        config["tag"]["diamond_threads"]
    log:
        f"{LOGS}/single_sample_tag/{{sample}}.log",
    shell:
        """
        mkdir -p $(dirname {output.cluster}) $(dirname {log})
        python -m pantag.single_sample_tag \
          --sample-id {wildcards.sample} \
          --workdir {params.workdir} \
          --mcscanx-bin {input.mcscanx_bin} \
          --mcscanx-gff {input.mcscanx_gff} \
          --gene-map {input.gene_map} \
          --proteins {input.proteins} \
          --threads {threads} \
          --diamond-bin {params.diamond} \
          --config {input.config} \
          --gff {input.gff} \
          --fasta {input.fasta} \
          --flank-gene-count {params.flank_genes} \
          --output-final {output.final} \
          --min-identity {params.identity} \
          --min-query-coverage {params.query_coverage} \
          --min-subject-coverage {params.subject_coverage} \
          --max-target-seqs {params.max_target_seqs} \
          --output-blast-raw {output.blast_raw} \
          --output-blast {output.blast} \
          --output-tandem {output.tandem} \
          --output-cluster {output.cluster} \
          > {log} 2>&1
        """


rule retrieve_pseudogenes:
    input:
        config=lambda wc: workflow.configfiles[0],
        cluster=f"{WORK}/{{sample}}/{{sample}}_gene.cluster",
        proteins=f"{WORK}/{{sample}}/{{sample}}_renamed_protein.faa",
        gff=sample_gff,
        fasta=sample_fasta,
    output:
        final=(
            f"{RESULTS}/local_tags/{{sample}}_TAGs.tsv"
            if PSEUDOGENE_ENABLED
            else f"{WORK}/{{sample}}/{{sample}}_unused_pseudogene_TAGs.tsv"
        ),
    params:
        workdir=lambda wc: f"{WORK}/{wc.sample}/pseudogenes",
        flank_bp=PSEUDOGENE_CONFIG["search_flank_bp"],
        flank_genes=FLANK_CONFIG["gene_count"],
        identity=PSEUDOGENE_CONFIG["blastx_identity"],
        query_coverage=PSEUDOGENE_CONFIG["blastx_query_coverage"],
        subject_coverage=PSEUDOGENE_CONFIG["blastx_subject_coverage"],
        diamond=DIAMOND_BIN,
    threads:
        config["tag"]["diamond_threads"]
    log:
        f"{LOGS}/retrieve_pseudogenes/{{sample}}.log",
    shell:
        """
        mkdir -p {params.workdir} $(dirname {output.final}) $(dirname {log})
        python -m pantag.retrieve_pseudogenes \
          --sample-id {wildcards.sample} \
          --config {input.config} \
          --cluster {input.cluster} \
          --proteins {input.proteins} \
          --gff {input.gff} \
          --fasta {input.fasta} \
          --workdir {params.workdir} \
          --threads {threads} \
          --diamond-bin {params.diamond} \
          --flank-bp {params.flank_bp} \
          --flank-gene-count {params.flank_genes} \
          --min-identity {params.identity} \
          --min-query-coverage {params.query_coverage} \
          --min-subject-coverage {params.subject_coverage} \
          --output {output.final} \
          > {log} 2>&1
        """


rule merge:
    input:
        local_tags=expand(
            f"{RESULTS}/local_tags/{{sample}}_TAGs.tsv",
            sample=ALL_SAMPLES,
        ),
    output:
        tags=f"{WORK}/global/pangenome_TAGs.unrefined.tsv",
        mapping=LOCAL_TO_GLOBAL,
    params:
        reference=REFERENCE,
        threshold=config["merge"]["member_overlap_threshold"],
        same_seqid_arg=(
            "--require-same-seqid"
            if config["merge"]["require_same_seqid"]
            else ""
        ),
    log:
        f"{LOGS}/merge.log",
    shell:
        """
        mkdir -p $(dirname {output.tags}) $(dirname {log})
        python -m pantag.merge \
          --reference-sample {params.reference} \
          --local-tags {input.local_tags} \
          --member-overlap-threshold {params.threshold} \
          {params.same_seqid_arg} \
          --output-tags {output.tags} \
          --output-mapping {output.mapping} \
          > {log} 2>&1
        """


rule refine:
    input:
        config=lambda wc: workflow.configfiles[0],
        tags=f"{WORK}/global/pangenome_TAGs.unrefined.tsv",
        samples=SAMPLES_FILE,
        reference_fasta=REFERENCE_FASTA,
        reference_gff=REFERENCE_GFF,
        target_fastas=[TARGETS[sample]["fasta"] for sample in TARGETS],
        fasta_indexes=FASTA_INDEXES,
        target_gffs=[SAMPLE_GFFS[sample] for sample in TARGETS],
    output:
        tags=f"{RESULTS}/global/pangenome_TAGs.tsv",
        matrix=f"{RESULTS}/global/refined_TAG_count_matrix.tsv",
        manifest=f"{DOWNSTREAM_WORK}/TAG_sequence_manifest.tsv",
        id_map=f"{WORK}/global/refined_cluster_id_map.tsv",
        span_audit=f"{WORK}/global/span_removed_clusters.tsv",
    params:
        target_gff_dir=f"{RESULTS}/liftoff",
        workdir=f"{WORK}/refine",
        flank_gene_count=FLANK_CONFIG["gene_count"],
        flank_overlap_threshold=REFINE_FLANK_THRESHOLD,
    threads:
        REFINE_CONFIG["threads"]
    log:
        f"{LOGS}/refine.log",
    shell:
        """
        mkdir -p $(dirname {output.matrix}) $(dirname {log})
        python -m pantag.refine \
          --tags {input.tags} \
          --config {input.config} \
          --samples {input.samples} \
          --reference-sample {REFERENCE} \
          --reference-fasta {input.reference_fasta} \
          --reference-gff {input.reference_gff} \
          --fasta-indexes {input.fasta_indexes:q} \
          --target-gff-dir {params.target_gff_dir} \
          --flank-gene-count {params.flank_gene_count} \
          --flank-overlap-threshold {params.flank_overlap_threshold} \
          --threads {threads} \
          --workdir {params.workdir} \
          --output-tags {output.tags} \
          --output-matrix {output.matrix} \
          --output-manifest {output.manifest} \
          --output-id-map {output.id_map} \
          --output-span-audit {output.span_audit} \
          > {log} 2>&1
        """


checkpoint downstream_extract:
    input:
        manifest=f"{DOWNSTREAM_WORK}/TAG_sequence_manifest.tsv",
        matrix=f"{RESULTS}/global/refined_TAG_count_matrix.tsv",
        samples=SAMPLES_FILE,
        reference_fasta=REFERENCE_FASTA,
        target_fastas=[TARGETS[sample]["fasta"] for sample in TARGETS],
        fasta_indexes=FASTA_INDEXES,
    output:
        fastas=directory(f"{DOWNSTREAM_WORK}/sequences/per_TAG"),
        records=f"{DOWNSTREAM_WORK}/sequences/sequence_records.tsv",
    threads:
        EXTRACT_CONFIG["threads"]
    params:
        tag_args=" ".join(f"--tag {tag}" for tag in RUNTIME_DOWNSTREAM_TARGETS),
    log:
        f"{LOGS}/downstream/extract.log",
    shell:
        """
        mkdir -p $(dirname {output.records}) $(dirname {log})
        python -m pantag.downstream.extract \
          --manifest {input.manifest} \
          --matrix {input.matrix} \
          --samples {input.samples} \
          --reference-sample {REFERENCE} \
          --reference-fasta {input.reference_fasta} \
          --fasta-indexes {input.fasta_indexes:q} {params.tag_args} \
          --threads {threads} \
          --output-dir {output.fastas} \
          --output-records {output.records} \
          > {log} 2>&1
        """


def selected_tags(wildcards):
    """Return explicit targets, or discover all targets after extraction."""
    if not RUNTIME_DOWNSTREAM_ALL:
        return RUNTIME_DOWNSTREAM_TARGETS
    matrix = Path(f"{RESULTS}/global/refined_TAG_count_matrix.tsv")
    if matrix.is_file():
        with matrix.open(encoding="utf-8", newline="") as handle:
            return [row["global_tag_id"] for row in csv.DictReader(handle, delimiter="\t")]
    extraction = checkpoints.downstream_extract.get()
    pattern = os.path.join(str(extraction.output.fastas), "{global_tag}.fa")
    return sorted(glob_wildcards(pattern).global_tag)


def extracted_sequence(wildcards):
    """Wait for extraction only when a published sequence is missing."""
    extraction = checkpoints.downstream_extract.get()
    return os.path.join(str(extraction.output.fastas), f"{wildcards.global_tag}.fa")


def missing_published_sequence(wildcards):
    path = Path(f"{DOWNSTREAM}/{wildcards.global_tag}/sequences/{wildcards.global_tag}_sequences.fa")
    return [] if path.is_file() else [str(path)]


def selected_cluster_summaries(wildcards):
    return expand(
        f"{DOWNSTREAM_WORK}/clusters/{{global_tag}}/summary.tsv",
        global_tag=selected_tags(wildcards),
    )


checkpoint selected_clusters_ready:
    input:
        selected_cluster_summaries,
    output:
        touch(f"{DOWNSTREAM_WORK}/clusters/.selection_{DOWNSTREAM_SELECTION_ID}.ready"),
    shell:
        """
        mkdir -p $(dirname {output})
        touch {output}
        """


def selected_clusters_ready_output(wildcards):
    """Wait for this run's selected clusters without scheduling older clusters."""
    return checkpoints.selected_clusters_ready.get().output[0]


def existing_cluster_summaries(wildcards):
    """List completed summaries for cumulative merging, not as DAG dependencies."""
    return sorted(
        str(path)
        for path in Path(f"{DOWNSTREAM_WORK}/clusters").glob("*/summary.tsv")
    )


def drawable_structure_outputs(wildcards):
    checkpoints.selected_clusters_ready.get()
    outputs = []
    for tag in selected_tags(wildcards):
        summary_path = Path(f"{DOWNSTREAM_WORK}/clusters/{tag}/summary.tsv")
        coordinates_path = Path(f"{DOWNSTREAM}/{tag}/clusters/{tag}_pcoa_coordinates.tsv")
        with summary_path.open(encoding="utf-8", newline="") as handle:
            row = next(csv.DictReader(handle, delimiter="\t"), None)
        if row and row.get("status") == "ok" and coordinates_path.is_file():
            with coordinates_path.open(encoding="utf-8") as handle:
                if sum(1 for _ in handle) > 1:
                    outputs.append(f"{DOWNSTREAM}/{tag}/clusters/{tag}_TAG_structure.pdf")
                    outputs.append(f"{DOWNSTREAM}/{tag}/clusters/{tag}_TAG_structure_collapsed.pdf")
    return outputs


def selected_sequence_outputs(wildcards):
    return expand(
        f"{DOWNSTREAM}/{{global_tag}}/sequences/{{global_tag}}_sequences.fa",
        global_tag=selected_tags(wildcards),
    )


rule downstream_publish_sequence:
    input:
        extracted_sequence,
    output:
        f"{DOWNSTREAM}/{{global_tag}}/sequences/{{global_tag}}_sequences.fa",
    shell:
        """
        mkdir -p $(dirname {output})
        cp {input:q} {output:q}
        """


rule downstream_sequences:
    input:
        selected_sequence_outputs,


rule downstream_cluster_tag:
    input:
        sequence_ready=missing_published_sequence,
        records=f"{DOWNSTREAM_WORK}/TAG_sequence_manifest.tsv",
    output:
        summary=f"{DOWNSTREAM_WORK}/clusters/{{global_tag}}/summary.tsv",
        coordinates=f"{DOWNSTREAM}/{{global_tag}}/clusters/{{global_tag}}_pcoa_coordinates.tsv",
        pcoa=CLUSTER_PCOA_PATTERN,
    params:
        fasta=lambda wc: f"{DOWNSTREAM}/{wc.global_tag}/sequences/{wc.global_tag}_sequences.fa",
        k=CLUSTER_CONFIG["k"],
        ubiquitous=CLUSTER_CONFIG["ubiquitous_threshold"],
        max_clusters=CLUSTER_CONFIG["max_clusters"],
        silhouette_tolerance=CLUSTER_CONFIG["silhouette_tolerance"],
        min_sequences=CLUSTER_CONFIG["min_sequences"],
        seed=CLUSTER_CONFIG["seed"],
        jitter=CLUSTER_CONFIG["pcoa_jitter_frac"],
        point_size=CLUSTER_CONFIG["pcoa_point_size"],
        alpha=CLUSTER_CONFIG["pcoa_alpha"],
        pcoa_arg=lambda wc: (
            f"--pcoa {DOWNSTREAM}/{wc.global_tag}/clusters/{wc.global_tag}_pcoa.pdf"
            if PCOA_ENABLED else ""
        ),
        pcoa_finalize="true" if PCOA_ENABLED else "touch",
    threads:
        CLUSTER_CONFIG["threads"]
    log:
        f"{LOGS}/downstream/cluster/{{global_tag}}.log",
    wildcard_constraints:
        global_tag="[A-Za-z0-9_.-]+",
    shell:
        """
        mkdir -p $(dirname {output.summary}) $(dirname {log})
        python -m pantag.downstream.cluster run \
          --global-tag-id {wildcards.global_tag} \
          --fasta {params.fasta:q} \
          --records {input.records} \
          --summary {output.summary} \
          --pcoa-coordinates {output.coordinates} \
          {params.pcoa_arg} \
          --k {params.k} \
          --ubiquitous-threshold {params.ubiquitous} \
          --max-clusters {params.max_clusters} \
          --silhouette-tolerance {params.silhouette_tolerance} \
          --min-sequences {params.min_sequences} \
          --seed {params.seed} \
          --pcoa-jitter-frac {params.jitter} \
          --pcoa-point-size {params.point_size} \
          --pcoa-alpha {params.alpha} \
          --threads {threads} \
          > {log} 2>&1
        {params.pcoa_finalize} {output.pcoa:q}
        """


rule build_structure_gene_index:
    input:
        samples=SAMPLES_FILE,
        config=CONFIG_PATH,
        gffs=list(SAMPLE_GFFS.values()),
    output:
        STRUCTURE_GENE_INDEX,
    threads:
        workflow.cores
    log:
        f"{LOGS}/downstream/structure_index.log",
    shell:
        """
        mkdir -p $(dirname {output}) $(dirname {log})
        python -m pantag.downstream.structure index \
          --samples {input.samples} \
          --config {input.config} \
          --run-dir {LAUNCH_DIR} \
          --liftoff-dir {RESULTS}/liftoff \
          --threads {threads} \
          --output {output} \
          > {log} 2>&1
        """


